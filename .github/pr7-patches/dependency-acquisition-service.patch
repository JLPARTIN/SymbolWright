+        policy.policyVersion,
+      ),
+      emergencyDisabled:
+        this.env['SYMBOLWRIGHT_DISABLE_DEPENDENCY_ACQUISITION'] === 'true' ||
+        this.env[
+          `SYMBOLWRIGHT_DISABLE_DEPENDENCY_POLICY_${environmentKey(policy.policyId)}`
+        ] === 'true',
+    }
+  }
+}
