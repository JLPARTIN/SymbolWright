{
  "name": "codemind",
  "version": "0.1.0",
  "description": "Standalone AI coding-agent platform for repo intelligence, code generation, bug fixing, planning, PR review, and merge-readiness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:app": "npm run typecheck && npm run build",
    "prepublishOnly": "npm run build:app"
  },
  "keywords": [
    "codemind",
    "coding-agent",
    "repo-intelligence",
    "pr-review",
    "merge-readiness",
    "ajna"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/jlpartin/codemind.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
