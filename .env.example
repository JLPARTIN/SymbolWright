# Copy this file to `.env` and fill in only what you need. `.env` is gitignored — never commit
# real credentials. Every variable below is optional unless noted; SymbolWright runs in
# browser-only / local-diagnostics mode with none of them set.

# ---------------------------------------------------------------------------
# LLM provider credentials — set at least one to enable AI-backed features.
# See docs/PROVIDER_KEYS.md for the full list and how each maps to a providerId.
# ---------------------------------------------------------------------------

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# GitHub Models (also doubles as your GitHub credential, see below)
GITHUB_TOKEN=

# A custom OpenAI-compatible endpoint (self-hosted model, local proxy, etc.)
SYMBOLWRIGHT_OPENAI_COMPATIBLE_API_KEY=
SYMBOLWRIGHT_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# ---------------------------------------------------------------------------
# Provider/agent defaults — all optional, override per-request via CLI flags.
# ---------------------------------------------------------------------------

# One of: openai, anthropic, google-gemini, groq, openrouter, github-models, ollama, deepseek, custom
SYMBOLWRIGHT_PROVIDER=

# Model id passed through to the selected provider (e.g. claude-sonnet-5, gpt-4o-mini)
SYMBOLWRIGHT_MODEL=

# Maximum output tokens per model request
SYMBOLWRIGHT_MAX_TOKENS=

# Comma-separated provider fallback order, tried in sequence on failure
SYMBOLWRIGHT_PROVIDER_FALLBACKS=

# READ_ONLY (default) or APPROVED_EXECUTION — see docs/ARCHITECTURE.md for the runtime-mode model
SYMBOLWRIGHT_RUNTIME_MODE=

# ---------------------------------------------------------------------------
# GitHub write access — required only for branch/commit/push/PR operations.
# Prefer a GitHub App installation (docs/security/DELEGATED_AGENT_ACCESS.md, Section 6) over a
# personal access token where possible; GITHUB_TOKEN above is the documented fallback.
# ---------------------------------------------------------------------------

GITHUB_APP_ID=
# Either the PEM contents directly, or GITHUB_APP_PRIVATE_KEY_PATH pointing at a file on disk.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# ---------------------------------------------------------------------------
# Semantic search / repository indexing (optional; falls back to a local hash embedder)
# ---------------------------------------------------------------------------

# 'voyage' or 'hash'
SYMBOLWRIGHT_EMBEDDING_PROVIDER=
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# `symbolwright serve` (the bundled HTTP API + browser UI) — see `symbolwright serve --help`.
# SYMBOLWRIGHT_API_KEY is the operator credential clients must present; treat it like a password.
# ---------------------------------------------------------------------------

SYMBOLWRIGHT_API_KEY=
# TLS is optional locally but strongly recommended whenever the server is reachable beyond
# localhost — see docs/security/DELEGATED_AGENT_ACCESS.md for the threat model this protects.
SYMBOLWRIGHT_TLS_CERT_FILE=
SYMBOLWRIGHT_TLS_KEY_FILE=

# ---------------------------------------------------------------------------
# Sandbox execution (advanced; leave unset unless you understand the tradeoff)
# ---------------------------------------------------------------------------

# Local-operator break-glass only: directly runs trusted code with host language runtimes.
# This is not a strong sandbox, does not isolate host network/filesystem access, is forbidden in
# hosted mode, and is rejected by the HTTP sandbox API and the sandbox_execute agent tool.
# No container failure ever falls back to this path automatically.
SYMBOLWRIGHT_ALLOW_GUARDED_HOST_EXECUTION=
