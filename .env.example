# Copy this file to `.env` and fill in only what you need. `.env` is gitignored — never commit
# real credentials. Every variable below is optional unless noted; SymbolWright runs in
# browser-only / local-diagnostics mode with none of them set.

# ---------------------------------------------------------------------------
# LLM provider credentials — set at least one to enable AI-backed features.
# See docs/PROVIDER_KEYS.md for the full list and how each maps to a providerId.
# ---------------------------------------------------------------------------

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# GitHub Models (also doubles as your GitHub credential, see below)
GITHUB_TOKEN=

# A custom OpenAI-compatible endpoint (self-hosted model, local proxy, etc.)
SYMBOLWRIGHT_OPENAI_COMPATIBLE_API_KEY=
SYMBOLWRIGHT_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# ---------------------------------------------------------------------------
# Provider/agent defaults — all optional, override per-request via CLI flags.
# ---------------------------------------------------------------------------

# One of: openai, anthropic, google-gemini, groq, openrouter, github-models, ollama, deepseek, custom
SYMBOLWRIGHT_PROVIDER=

# Model id passed through to the selected provider (e.g. claude-sonnet-5, gpt-4o-mini)
SYMBOLWRIGHT_MODEL=

# Maximum output tokens per model request
SYMBOLWRIGHT_MAX_TOKENS=

# Comma-separated provider fallback order, tried in sequence on failure
SYMBOLWRIGHT_PROVIDER_FALLBACKS=

# READ_ONLY (default) or APPROVED_EXECUTION — see docs/ARCHITECTURE.md for the runtime-mode model
SYMBOLWRIGHT_RUNTIME_MODE=

# ---------------------------------------------------------------------------
# GitHub write access — required only for branch/commit/push/PR operations.
# Prefer a GitHub App installation (docs/security/DELEGATED_AGENT_ACCESS.md, Section 6) over a
# personal access token where possible; GITHUB_TOKEN above is the documented fallback.
# ---------------------------------------------------------------------------

GITHUB_APP_ID=
# Either the PEM contents directly, or GITHUB_APP_PRIVATE_KEY_PATH pointing at a file on disk.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# ---------------------------------------------------------------------------
# Semantic search / repository indexing (optional; falls back to a local hash embedder)
# ---------------------------------------------------------------------------

# 'voyage' or 'hash'
SYMBOLWRIGHT_EMBEDDING_PROVIDER=
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# `symbolwright serve` (the bundled HTTP API + browser UI) — see `symbolwright serve --help`.
# SYMBOLWRIGHT_API_KEY is the operator credential clients must present; treat it like a password.
# ---------------------------------------------------------------------------

SYMBOLWRIGHT_API_KEY=
# TLS is optional locally but strongly recommended whenever the server is reachable beyond
# localhost — see docs/security/DELEGATED_AGENT_ACCESS.md for the threat model this protects.
SYMBOLWRIGHT_TLS_CERT_FILE=
SYMBOLWRIGHT_TLS_KEY_FILE=

# ---------------------------------------------------------------------------
# Sandbox execution (advanced; leave unset unless you understand the tradeoff)
# ---------------------------------------------------------------------------

# Local-operator break-glass only: directly runs trusted code with host language runtimes.
# This is not a strong sandbox, does not isolate host network/filesystem access, is forbidden in
# hosted mode, and is rejected by the HTTP sandbox API and the sandbox_execute agent tool.
# No container failure ever falls back to this path automatically.
SYMBOLWRIGHT_ALLOW_GUARDED_HOST_EXECUTION=

# Opt in to the real strong offline container executor. Before setting true, preinstall the exact
# digest-pinned image listed by `symbolwright sandbox images`. Normal execution uses --pull=never;
# it never downloads images or enables container network access. The first executable image supports
# JavaScript only. Container failure never falls back to guarded-host.
SYMBOLWRIGHT_ENABLE_STRONG_CONTAINER_EXECUTION=false

# Optional host path for strong-sandbox temporary work and artifact quarantine. This path must be
# outside the canonical repository, host home directories, and container-engine socket locations.
# When unset, SymbolWright uses a repository-scoped directory below the operating-system temp root.
SYMBOLWRIGHT_SANDBOX_STATE_ROOT=

# Emergency kill switch. Set true to refuse every structured sandbox execution before backend
# selection. Keep false/unset during normal operation.
SYMBOLWRIGHT_DISABLE_SANDBOX_EXECUTION=false

# Increment when the global sandbox authority changes. Version-bound approvals and policy evidence
# fail closed when they reference a stale value.
SYMBOLWRIGHT_SANDBOX_GLOBAL_POLICY_VERSION=1

# ---------------------------------------------------------------------------
# Sandbox network runtime (advanced; strong containers remain --network none)
# ---------------------------------------------------------------------------

# Unified operator-owned policy file for governed dependency acquisition and brokered egress,
# shared by the HTTP route, agent-loop tool chokepoint, MCP, and the sandbox network control
# plane (GET /api/sandbox/network-status). Without this file, startup succeeds in explicit
# offline-only mode -- no dependency acquisition or egress is possible for any caller. See
# docs/security/SANDBOX_NETWORK_GATEWAY_COMPOSITION.md for the JSON schema (dependencyProfiles,
# egressProfiles, defaultDependencyPolicy, defaultEgressPolicy).
SYMBOLWRIGHT_SANDBOX_NETWORK_POLICY_FILE=

# ---------------------------------------------------------------------------
# Legacy brokered sandbox egress (superseded by SYMBOLWRIGHT_SANDBOX_NETWORK_POLICY_FILE above;
# kept for backward compatibility with existing deployments)
# ---------------------------------------------------------------------------

# JSON array of operator-owned, versioned egress profiles. Without this file, runtime
# execution remains offline and the operator state is "dependency-only".
SYMBOLWRIGHT_EGRESS_POLICY_FILE=

# Independent emergency kill switch for all runtime egress broker sessions.
SYMBOLWRIGHT_DISABLE_SANDBOX_EGRESS=false

# Increment whenever global egress authority changes. Existing approvals and active sessions
# fail closed when bound to an older value.
SYMBOLWRIGHT_EGRESS_GLOBAL_POLICY_VERSION=1

# Optional per-profile live-revision controls use the normalized policy id, for example:
# SYMBOLWRIGHT_EGRESS_POLICY_VERSION_RUNTIME_API=3
# SYMBOLWRIGHT_DISABLE_EGRESS_POLICY_RUNTIME_API=false
